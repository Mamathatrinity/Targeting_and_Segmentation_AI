{
    "module":  "Login",
    "test_cases":  [
                       {
                           "name":  "test_login_valid_e2e",
                           "description":  "User logs in with valid credentials and system validates UI, API session, and database login timestamp",
                           "steps":  [
                                         {
                                             "action":  "navigate",
                                             "target":  "url",
                                             "value":  "https://app.healthcare.com/login",
                                             "expected":  "Login page loads successfully",
                                             "layer":  "UI"
                                         },
                                         {
                                             "action":  "fill",
                                             "target":  "Email",
                                             "value":  "john.doe@healthcare.com",
                                             "expected":  "Email field populated with john.doe@healthcare.com",
                                             "layer":  "UI"
                                         },
                                         {
                                             "action":  "fill",
                                             "target":  "Password",
                                             "value":  "SecurePass123!",
                                             "expected":  "Password field populated (masked)",
                                             "layer":  "UI"
                                         },
                                         {
                                             "action":  "click",
                                             "target":  "Login",
                                             "expected":  "Login form submitted, redirect initiated",
                                             "layer":  "UI"
                                         },
                                         {
                                             "action":  "verify_text",
                                             "expected":  "Welcome, John",
                                             "layer":  "UI"
                                         },
                                         {
                                             "action":  "verify_api",
                                             "endpoint":  "/api/auth/session",
                                             "expected_status":  200,
                                             "expected":  "Session API returns 200 with valid user_id and token",
                                             "layer":  "API"
                                         },
                                         {
                                             "action":  "verify_api_field",
                                             "endpoint":  "/api/auth/session",
                                             "field":  "user.email",
                                             "expected_value":  "john.doe@healthcare.com",
                                             "expected":  "API response contains correct user email",
                                             "layer":  "API"
                                         },
                                         {
                                             "action":  "verify_db",
                                             "table":  "users",
                                             "column":  "last_login",
                                             "condition":  "IS NOT NULL WHERE email = \u0027john.doe@healthcare.com\u0027",
                                             "expected":  "Database shows last_login timestamp updated within last 10 seconds",
                                             "layer":  "DB"
                                         },
                                         {
                                             "action":  "verify_db",
                                             "table":  "users",
                                             "column":  "login_count",
                                             "condition":  "\u003e 0 WHERE email = \u0027john.doe@healthcare.com\u0027",
                                             "expected":  "Login count incremented by 1",
                                             "layer":  "DB"
                                         }
                                     ],
                           "scenario_type":  "positive",
                           "scenario_text":  "User logs in with email \u0027john.doe@healthcare.com\u0027 and password \u0027SecurePass123!\u0027, sees \u0027Welcome, John\u0027 message on Dashboard",
                           "focus_area":  "authentication"
                       },
