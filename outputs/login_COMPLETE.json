                       {
                           "name":  "test_login_sql_injection_blocked",
                           "description":  "Security test: SQL injection attempt is sanitized, login blocked, and security event logged",
                           "steps":  [
                                         {
                                             "action":  "navigate",
                                             "target":  "url",
                                             "value":  "https://app.example.com/login",
                                             "expected":  "Login page loads",
                                             "layer":  "UI"
                                         },
                                         {
                                             "action":  "fill",
                                             "target":  "Email",
                                             "value":  "admin\u0027 OR \u00271\u0027=\u00271\u0027 --",
                                             "expected":  "Malicious input entered in email field",
                                             "layer":  "UI"
                                         },
                                         {
                                             "action":  "fill",
                                             "target":  "Password",
                                             "value":  "anypassword",
                                             "expected":  "Password field populated",
                                             "layer":  "UI"
                                         },
                                         {
                                             "action":  "click",
                                             "target":  "Login",
                                             "expected":  "Login attempt submitted",
                                             "layer":  "UI"
                                         },
                                         {
                                             "action":  "verify_text",
                                             "expected":  "Invalid email format",
                                             "layer":  "UI"
                                         },
                                         {
                                             "action":  "verify_api",
                                             "endpoint":  "/api/auth/login",
                                             "expected_status":  400,
                                             "expected":  "API rejects malicious input with 400 Bad Request",
                                             "layer":  "API"
                                         },
                                         {
                                             "action":  "verify_api_field",
                                             "endpoint":  "/api/auth/login",
                                             "field":  "error",
                                             "expected_value":  "Invalid email format",
                                             "expected":  "API error message confirms input validation",
                                             "layer":  "API"
                                         },
                                         {
                                             "action":  "verify_db",
                                             "table":  "security_logs",
                                             "column":  "event_type",
                                             "condition":  "= \u0027sql_injection_attempt\u0027 ORDER BY created_at DESC LIMIT 1",
                                             "expected":  "Security event logged with SQL injection attempt details",
                                             "layer":  "DB"
                                         }
                                     ],
                           "scenario_type":  "negative",
                           "scenario_text":  "User enters SQL injection \u0027admin\u0027 OR \u00271\u0027=\u00271\u0027 -- in email field, system shows \u0027Invalid email format\u0027 and blocks login",
                           "focus_area":  "authentication"
                       },
